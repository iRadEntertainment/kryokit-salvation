config_version=5

[application]

config/name="Kryokit salvation"
config/description="A forklift simulation game for the Jern Jam 2026"
config/version="0.1"
run/main_scene="uid://31e1t125m574"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://eaayxbbjpfm5"
config/icon="uid://licoagq3nfus"
boot_splash/minimum_display_time=3000

[audio]

buses/default_bus_layout="uid://cr1kg4urwvyq1"

[autoload]

Mng="*uid://dil0b7w6s2qgd"
Aud="*uid://6vyc3t2jgbu"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="uid://pnmwnb6d5ysq"

[importer_defaults]

scene={
&"gltf/embedded_image_handling": 2,
&"materials/extract": 1,
&"materials/extract_format": 1,
&"materials/extract_path": "res://assets/materials"
}

