[sub_resource type="Shader" id="Shader_2g2b4"]
code = "shader_type spatial;
render_mode specular_disabled, depth_draw_opaque, cull_disabled;

// Texture & Material Uniforms
uniform sampler2D albedo_texture : source_color, filter_linear_mipmap, repeat_disable;
uniform float alpha_scissor_threshold : hint_range(0.0, 1.0) = 0.5;

// Billboard Uniforms
uniform bool enable_billboard = true;

// Sway Uniforms
uniform float wind_speed : hint_range(0.0, 10.0) = 2.0;
uniform float wind_strength : hint_range(0.0, 2.0) = 0.15;
uniform float wind_scale : hint_range(0.0, 5.0) = 0.5;

void vertex() {
	// 1. Y-Axis Billboard (Face the camera while remaining upright)
	if (enable_billboard) {
		MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
			vec4(normalize(cross(vec3(0.0, 1.0, 0.0), INV_VIEW_MATRIX[2].xyz)), 0.0),
			vec4(0.0, 1.0, 0.0, 0.0),
			vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, vec3(0.0, 1.0, 0.0))), 0.0),
			MODEL_MATRIX[3]
		);
	}

	// 2. Wind Sway Offset
	// (1.0 - UV.y) ensures sway strength increases toward the top (UV.y = 0.0) 
	// while keeping the roots stationary (UV.y = 1.0).
	float height_factor = 1.0 - UV.y;
	
	// Add spatial variation using world position so trees don't sway perfectly in sync
	float world_offset = (NODE_POSITION_WORLD.x + NODE_POSITION_WORLD.z) * wind_scale;
	float wave = sin(TIME * wind_speed + world_offset);

	VERTEX.x += wave * wind_strength * height_factor;
}

void fragment() {
	vec4 tex = texture(albedo_texture, UV);
	ALBEDO = tex.rgb;
	
	// Alpha scissor avoids transparency sorting issues for distant objects
	ALPHA = tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor_threshold;
}"

